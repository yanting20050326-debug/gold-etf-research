{
  "name": "gold-research-trigger",
  "main": "src/index.js",
  "compatibility_date": "2026-09-02",
  // 只有 TWSE 交易時段（台北 08:30-14:30，週一到週五）才需要每 5 分鐘觸發
  // 一次；這個時段以外 build_site.py 本來就會跳過 TWSE 抓取、只更新國際金
  // 價，改成每小時觸發一次就夠。Cloudflare Cron Triggers 一律用 UTC，台北
  // 是 UTC+8 無日光節約，08:30-14:30 台北 = 00:30-06:30 UTC，同一天不會跨
  // 日期。Private repo 上的 GitHub Actions 分鐘數是這樣算的：全天候每 5
  // 分鐘觸發在這個 repo 上一個月會燒到快 9000 分鐘、遠超過私有 repo 每月
  // 2000 分鐘的免費額度；這個排程算下來一個月大約只有 2100-2200 分鐘，
  // 幾乎壓在免費額度內。Workers Free 方案每個帳號最多 5 條 cron trigger，
  // 這裡剛好卡在上限，週六、週日只能合併成同一條（逗號分隔），沒辦法再
  // 拆成獨立的兩條。day-of-week 用 0 代表週日在 Cloudflare 這裡會被拒絕
  // （invalid cron string），要用 7。
  "triggers": {
    "crons": [
      "30-59/5 0 * * 1-5",
      "*/5 1-5 * * 1-5",
      "0-30/5 6 * * 1-5",
      "0 7-23 * * 1-5",
      "0 * * * 6,7"
    ]
  }
}
